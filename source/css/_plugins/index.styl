@import 'lazyload'
@import 'aplayer'

// 根据主题配置加载
@import 'copycode'
if hexo-config('features.math.provider') == 'katex'
  @import 'katex'
if hexo-config('features.card_hover.spotlight') || hexo-config('features.card_hover.tilt')
  // 最后加载，组合并覆盖 link/grid 既有 hover transform
  @import 'card-hover'

// View Transitions API - 主题切换动画
@import 'theme-toggle-animation'

// AI 摘要（chuckle-post-ai）：legacy plugins.tianli_gpt 与新 features.tianli_gpt 都支持
if hexo-config('plugins.tianli_gpt.enable') || hexo-config('features.tianli_gpt.enable')
  @import 'tianli-gpt'
