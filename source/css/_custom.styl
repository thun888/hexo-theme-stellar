@require('_defines/const')
@require('_defines/typography')


// font family
$ff-body = convert(hexo-config('appearance.typography.font_family.body'))
$ff-code = convert(hexo-config('appearance.typography.font_family.code'))
$ff-codeblock = $ff-code

// font size
$fs-root = convert(hexo-config('appearance.typography.font_size.root'))
$fs-15 = 'calc(%s - 1px)' % var(--fs-content-base)
$fs-14 = 'calc(%s - 2px)' % var(--fs-content-base)
$fs-13 = 'calc(%s - 3px)' % var(--fs-content-base)
$fs-12 = 'calc(%s - 4px)' % var(--fs-content-base)

$fs-code = convert(hexo-config('appearance.typography.font_size.inline_code'))
$fs-codeblock = convert(hexo-config('appearance.typography.font_size.code_block'))

$fsh1 = 'calc(%s + 9px)' % var(--fs-content-base)
$fsh2 = 'calc(%s + 11px)' % var(--fs-content-base)
$fsh3 = 'calc(%s + 7px)' % var(--fs-content-base)
$fsh4 = 'calc(%s + 4px)' % var(--fs-content-base)
$fsh5 = 'calc(%s + 2px)' % var(--fs-content-base)

$fs-content-0 = 'calc(%s - 0px)' % var(--fs-content-base)
$fs-content-1 = 'calc(%s - 1px)' % var(--fs-content-base)
$fs-content-2 = 'calc(%s - 2px)' % var(--fs-content-base)
$fs-content-3 = 'calc(%s - 3px)' % var(--fs-content-base)

// site main
$site-background-image = hexo-config('appearance.backgrounds.page.image')


// colors
$c-theme = convert(hexo-config('appearance.colors.primary'))
$c-accent = convert(hexo-config('appearance.colors.accent'))
$c-link = convert(hexo-config('appearance.colors.link'))

$c-base-hue = 210deg // 背景/文本颜色的主基调（一般看不出来不需要修改）

$border-card-l = convert(hexo-config('appearance.shape.radius.card_large'))
$border-card = convert(hexo-config('appearance.shape.radius.card'))
$border-card-s = convert(hexo-config('appearance.shape.radius.card_small'))
$border-bar = convert(hexo-config('appearance.shape.radius.bar'))
$bar-item-gap = 4px // bar 容器内按钮/标签之间的间距与距边距离（gap + padding 共用）
$border-bar-container = 'calc(%s + %s)' % ($border-bar $bar-item-gap) // bar 容器圆角 = 按钮圆角（$border-bar）+ 间距，保持同心
$border-image-l = convert(hexo-config('appearance.shape.radius.image_large'))
$border-image = convert(hexo-config('appearance.shape.radius.image'))
$border-image-s = convert(hexo-config('appearance.shape.radius.image_small'))
$border-button = 8px
$corner-shape = convert(hexo-config('appearance.shape.corner'))

// shadow
$boxshadow-card = 0 1px 2px 0px rgba(0, 0, 0, 0.1)
$boxshadow-float = 0 4px 8px 0px rgba(0, 0, 0, 0.05)
$boxshadow-card-float = 0 12px 16px -4px rgba(0, 0, 0, 0.2)
$boxshadow-button = 0 0 2px 0px rgba(0, 0, 0, 0.04), 0 0 8px 0px rgba(0, 0, 0, 0.04)
$boxshadow-block = 0 1px 4px 0px rgba(0, 0, 0, 0.02), 0 2px 8px 0px rgba(0, 0, 0, 0.02)
$boxshadow-toast = 0 4px 8px 0px rgba(0, 0, 0, 0.1), 0 12px 16px -4px rgba(0, 0, 0, 0.2)
