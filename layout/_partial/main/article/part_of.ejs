<%
// 1.x 兼容：front-matter part_of —— 标注本文属于某篇/某组文章
var partOfValue = typeof part_of !== 'undefined' ? part_of : (page && page.part_of)
var partOfItems = Array.isArray(partOfValue)
  ? partOfValue.filter(function (item) { return item != null && String(item).trim() !== '' })
  : []
%>
<% if (partOfItems.length === 1) { %>
<div class="tag-plugin colorful note" color="blue">
  <div class="title"><strong>嗨</strong></div>
  <div class="body">
    <span>本文是该文章的一部分：</span>
    <%- markdown(partOfItems[0]).replace('<p>', '').replace('</p>', '') %>
  </div>
</div>
<% } else if (partOfItems.length > 1) { %>
<div class="tag-plugin colorful note" color="blue">
  <div class="title"><strong>嗨</strong></div>
  <div class="body">
    <p>本文是以下文章的一部分：</p>
    <ul>
      <% for (var partOfRef of partOfItems) { %>
      <li class="post-title"><%- markdown(partOfRef) %></li>
      <% } %>
    </ul>
  </div>
</div>
<% } %>
