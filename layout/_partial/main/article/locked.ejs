<%
var lockImage = stellar_config('profiles.error')?.lockImage || stellar_config('profiles.error')?.image
var reason = typeof lockReason !== 'undefined' ? lockReason : ''
%>
<article class='md-text error-page'>
  <% if (lockImage) { %>
  <h1><img id='error' src='<%- lockImage %>' alt='locked'></h1>
  <% } %>
  <p class='what'><strong><%= __('page.lock.what') %></strong></p>
  <p class='why'><%= reason || __('page.lock.why') %></p>
  <br><br>
  <a class='button' id='back' href='<%- config.root %>'><%= __('page.lock.action') %></a>
</article>
