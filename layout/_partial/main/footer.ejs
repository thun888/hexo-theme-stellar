<%
var siteFooter = stellar_config('footer')
// 仅在模板确实引用总字数时遍历，避免每页渲染都全量统计
var footerTotalWords = 0
if (siteFooter.content && siteFooter.content.indexOf('{site.posts.words}') !== -1) {
  site.posts.forEach(function(footerPost) {
    footerTotalWords += word_count(footerPost)
  })
}
var content = siteFooter.content
  ?.replace('{author.name}', (config.author || 'Anonymity'))
  ?.replace('{theme.name}', stellar_info('name'))
  ?.replace('{theme.version}', stellar_info('version'))
  ?.replace('{theme.tree}', stellar_info('tree'))
  ?.replace('{site.posts.length}', site.posts.length)
  ?.replace('{site.totalpages}', site.pages.length + site.posts.length)
  ?.replace('{site.posts.words}', footerTotalWords)
  ?.replace('{extra.info.buildtime}', new Date().toLocaleDateString('zh-CN'))
function layoutDiv() {
  var el = ''
  el += `<footer class="page-footer${scrollreveal(' ')} footnote">`
  el += '<hr>'
  // sitemap
  var sitemap = siteFooter.sitemap
  if (sitemap.length > 0) {
    var count = sitemap.length
    if ([6].includes(count)) {
      count = 3
    } else if ([7,8].includes(count)) {
      count = 4
    } else {
      count = Math.min(sitemap.length, 5)
    }
    el += `<div class="sitemap" style="column-count:${count};">`
    for (var group of sitemap) {
      var title = escape_html(group.title)
      var items = group.items
      if (items == undefined || items.length == 0) {
        continue
      }
      el += '<div class="sitemap-group">'
      el += '<span class="fs15">' + title + '</span>'
      items.forEach((item) => {
        el += '<a href="' + escape_html(url_for(md_link(item))) + '">'
        el += __(md_text(item))
        el += '</a>'
      });
      el += '</div>'
    }
    el += '</div>'
  }
  // footer
  el += '<div class="text">'
  if (content) {
    el += markdown(content)
  }
  // el += '<script> var allpostscount = "' + site.posts.length + '" ;var allpostswords = "' + totalcount(site) + '";</script>'
  el += '</div></footer>'
  return el
}
%>
<%- layoutDiv() %>
