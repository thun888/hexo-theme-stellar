<%
var shellDocument = documentModel || {}
var shellPage = pageModel || {}
var shellRegions = regions || {}
var language = escape_html(shellDocument.language || 'zh-CN')
var htmlAttributes = shellDocument.preferredTheme === 'auto' ? '' : ` data-theme="${escape_html(shellDocument.preferredTheme)}"`
var presentRegions = ['topbar', 'leftbar', 'rightbar'].filter(function(region) {
  return typeof shellRegions[region] === 'string' && shellRegions[region].trim().length > 0
})
var pageAttributes = ` data-page-type="${escape_html(shellPage.pageType || 'content')}"`
pageAttributes += ` data-page-layout="${escape_html(shellPage.layout || '')}"`
if (shellPage.articleStyle) pageAttributes += ` data-article-style="${escape_html(shellPage.articleStyle)}"`
if (shellPage.indent) pageAttributes += ' data-text-indent'

var bodyHtml = ''
bodyHtml += bodyBegin || ''
bodyHtml += siteBackground || ''
bodyHtml += cover || ''
bodyHtml += `<div class="site-shell" id="start" data-regions="${presentRegions.join(' ')}">`
bodyHtml += shellRegions.topbar || ''
bodyHtml += '<div class="site-workspace">'
bodyHtml += shellRegions.leftbar || ''
bodyHtml += `<main data-stellar-runtime-region class="site-main" id="main">${main || ''}</main>`
bodyHtml += shellRegions.rightbar || ''
bodyHtml += '</div>'
bodyHtml += '<button type="button" class="site-scrim" data-shell-action="dismiss-drawer" aria-label="Close navigation" tabindex="-1"></button>'
bodyHtml += controls || ''
bodyHtml += typeof overlays === 'string' ? overlays : ''
bodyHtml += '</div>'
bodyHtml += `<div class="site-scripts">${scripts || ''}</div>`

var html = '<!DOCTYPE html>'
html += `<html lang="${language}"${htmlAttributes}>`
html += head
html += `<body${pageAttributes}>`
html += bodyHtml
html += '</body></html>'
%>
<%- html %>
