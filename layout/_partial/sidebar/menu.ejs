<%
function layoutDiv() {
  var el = ''
  el += `<nav class="menu dis-select${where == 'main' ? ' mobile-hidden' : ''}">`
  for (let item of (theme.menubar.items || [])) {
    if (item == undefined || item.id == null || item.url == null) {
      continue
    }
    var active = item.id == page.menu_id
    el += `<a class="nav-item${active ? ' active' : ''}${item.theme?.length > 0 ? ' themed' : ''}"`
    var style = `--item-grad:url(#menu-grad-${item.id})`
    if (item.theme?.length > 0) {
      style += `;--item-theme:${item.theme}`
    }
    el += ` style="${style}"`
    el += ` title="${item.title}" href="${pretty_url(item.url)}">`
    if (item.icon?.length > 0) {
      el += icon(item.icon, 'no-lazy', true)
    }
    el += `<span>${__(item.title)}</span>`
    if (active) {
      el += `<span class="active-dot"></span>`
    }
    el += partial('grad-def', {id: 'menu-grad-' + item.id})
    el += `</a>`
  }
  if (language_switcher_enabled()) {
    var languageItems = language_versions(page)
    el += `<details class="language-switcher nav-item">`
    el += `<summary title="${escape_html(__('btn.language'))}">`
    el += `<span>${escape_html(__('btn.language'))}</span>`
    el += `</summary>`
    el += `<div class="language-options">`
    for (let language of languageItems) {
      if (language.available) {
        el += `<a class="language-option${language.current ? ' active' : ''}" href="${escape_html(language.href)}" hreflang="${escape_html(language.code)}">`
      } else {
        el += `<span class="language-option unavailable" aria-disabled="true">`
      }
      el += `<span>${escape_html(language.title)}</span>`
      if (language.current) el += `<span class="active-dot"></span>`
      el += language.available ? `</a>` : `</span>`
    }
    el += `</div></details>`
  }
  el += `</nav>`
  return el
}
%>

<%- layoutDiv() %>
