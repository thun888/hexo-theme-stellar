<%
var pageConfig = content_config(page)
var registeredProfile = pageConfig.collection?.profile
var postViewModel = page.layout === 'post' && (registeredProfile == null || registeredProfile === 'topic')
  ? (page.viewModel || post_view_model(page))
  : null
var wikiViewModel = page.viewModel?.collection?.profile === 'wiki' ? page.viewModel : null
var notebookViewModel = page.viewModel?.collection?.profile === 'notebook' ? page.viewModel : null
var requiredProfile = page.layout === 'post' ? (registeredProfile === 'topic' ? 'topic' : 'post') : registeredProfile
var activeViewModel = postViewModel || wikiViewModel || notebookViewModel
if (['post', 'wiki', 'topic', 'notebook'].includes(requiredProfile) && activeViewModel?.collection?.profile !== requiredProfile) {
  throw new Error(`Stellar v2: ${requiredProfile} 页面 ${page.source || page.path || '<unknown>'} 缺少 PageViewModel`)
}
// 是否使用 Heti 布局插件
const isUsingHeti = stellar_config('features.heti.enabled')

// 默认主导航菜单
if (!postViewModel && !wikiViewModel && !notebookViewModel) page.navigation = {
  menu: pageConfig.activeMenu,
  breadcrumb: pageConfig.breadcrumb
}
if (!postViewModel && !wikiViewModel && !notebookViewModel && page.navigation.menu == null) {
  var profiles = stellar_config('profiles')
  page.navigation.menu = profiles.page.activeMenu
}

function articleClass() {
  var str = `md-text content${scrollreveal(' ')}`
  if (isUsingHeti) {
    str += ' heti'
  }
  return str
}

function postArticleClass(article) {
  var str = `md-text content${scrollreveal(' ')}`
  if (article.heti) str += ' heti'
  return str
}

function postLayoutDiv() {
  var item = postViewModel.item
  var article = postViewModel.render.article
  var el = ''
  // 锁定文章：渲染锁定页面，跳过正文
  if (page.lock == true) {
    page.comment_title = '';
    page.header = false;
    page.robots = 'none';
    page.rightbar = [];
    var lockImage = stellar_config('profiles.error')?.lockImage || stellar_config('profiles.error')?.image
    el += `<article class='md-text error-page'>`
    if (lockImage) {
      el += `<h1><img id='error' src='${lockImage}' alt='locked'></h1>`
    }
    el += `<p class='what'><strong>${__('page.lock.what')}</strong></p>`
    if (page.lock_reason) {
      el += `<p class='why'>${page.lock_reason}</p>`
    } else {
      el += `<p class='why'>${__('page.lock.why')}</p>`
    }
    el += `<br><br>`
    el += `<a class='button' id='back' href='${config.root}'>${__('page.lock.action')}</a>`
    el += `</article>`
    return el
  }
  if (item.presentation.banner?.headline || item.title || item.content.length > 0) {
    el += partial('_partial/main/navbar/article_banner', {viewModel: postViewModel})
  }
  if (page.nav_tabs) {
    el += partial('_partial/main/navbar/nav_tabs_blog')
  }
  // 派生：文章所属系列提示
  el += partial('_partial/main/article/part_of', {part_of: page.part_of})
  // 过期提醒容器
  el += `<div id="expiration-reminder"></div>`
  el += `<article class="${postArticleClass(article)}">`
  el += item.content
  el += '</article>'
  el += partial('_partial/main/article/post_tags', {tags: article.tags})
  el += partial('_partial/main/article/share', {share: article.footer.share})
  el += partial('_partial/main/article/post_footer', {footer: article.footer})
  el += partial('_partial/main/article/post_read_next', {
    previous: article.previous,
    next: article.next
  })
  el += partial('_partial/main/article/post_related', {related: article.related})
  el += partial('_partial/comments/layout', {comments: article.comments})
  return el
}

function wikiLayoutDiv() {
  var item = wikiViewModel.item
  var article = wikiViewModel.render.article
  var el = ''
  if (article.banner?.headline || item.title || item.content.length > 0 || article.readmeHtml.length > 0) {
    el += partial('_partial/main/navbar/article_banner', {viewModel: wikiViewModel})
  }
  var cls = `md-text content${scrollreveal(' ')}`
  if (article.heti) cls += ' heti'
  el += partial('_partial/main/article/part_of', {part_of: page.part_of})
  el += `<article class="${cls}">`
  el += item.content.trim().length > 0 ? item.content : article.readmeHtml
  el += '</article>'
  el += partial('_partial/main/article/share', {share: article.footer.share})
  el += partial('_partial/main/article/post_footer', {footer: article.footer})
  el += partial('_partial/main/article/post_read_next', {
    previous: article.previous,
    next: article.next,
    previousLabel: __('meta.prev'),
    nextLabel: __('meta.next')
  })
  el += partial('_partial/comments/layout', {comments: article.comments})
  return el
}

function notebookLayoutDiv() {
  var item = notebookViewModel.item
  var article = notebookViewModel.render.article
  var el = ''
  if (article.banner?.headline || item.title || item.content.length > 0) {
    el += partial('_partial/main/navbar/article_banner', {viewModel: notebookViewModel})
  }
  el += partial('_partial/main/article/part_of', {part_of: page.part_of})
  el += `<article class="${postArticleClass(article)}">`
  el += item.content
  el += partial('_partial/main/notebook/note_tags', {tags: article.tags})
  el += '</article>'
  el += partial('_partial/main/article/share', {share: article.footer.share})
  el += partial('_partial/main/article/post_footer', {footer: article.footer})
  el += partial('_partial/comments/layout', {comments: article.comments})
  return el
}

function layoutDiv() {
  if (postViewModel) return postLayoutDiv()
  if (wikiViewModel) return wikiLayoutDiv()
  if (notebookViewModel) return notebookLayoutDiv()
  var el = ''
  if (pageConfig.banner?.headline || page.title || (page.content && page.content.length > 0)) {
    el += partial('_partial/main/navbar/article_banner')
  }
  el += `<article class="${articleClass()}">`
  if (page.content && String(page.content).trim().length > 0) el += page.content
  el += `</article>`
  el += partial('_partial/comments/layout', {comments: comments_model(page)})
  return el
}
%>

<%- layoutDiv() %>
